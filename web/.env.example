# Публичный адрес приложения (для return_url оплаты и деплоя)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Основной домен для бесплатных поддоменов (<имя>.BASE_DOMAIN)
# NEXT_PUBLIC_BASE_DOMAIN=tilda.netfree.pro

# Путь к файлу SQLite (по умолчанию: data/builder.db в папке приложения)
# DATABASE_PATH=/var/lib/builder/builder.db

# Папка для загруженных изображений (по умолчанию: data/uploads)
# UPLOADS_DIR=/var/lib/builder/uploads

# Платёжные провайдеры (Фаза 6). Пусто — провайдер выключен.
YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=
ROLLYPAY_API_KEY=
ROLLYPAY_SECRET=
