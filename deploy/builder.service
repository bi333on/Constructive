[Unit]
Description=Constructive — конструктор сайтов (Next.js)
After=network.target

[Service]
Type=simple
User=builder
Group=builder
WorkingDirectory=/opt/builder/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /opt/builder/web/node_modules/next/dist/bin/next start
Restart=always
RestartSec=5
TimeoutStopSec=20

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
