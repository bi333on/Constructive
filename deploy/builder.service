[Unit]
Description=Constructive — конструктор сайтов (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=builder
Group=builder
WorkingDirectory=/opt/builder/web
Environment=NODE_ENV=production
# Важно: именно -H localhost (не 127.0.0.1) — иначе origin реврайта в middleware
# не совпадёт с initUrl и поддомены падают с EPROTO за reverse-proxy.
ExecStart=/usr/bin/node /opt/builder/web/node_modules/next/dist/bin/next start -H localhost -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=20

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
