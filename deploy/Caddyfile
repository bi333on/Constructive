# Caddy: автоматический HTTPS + реверс-прокси на Next.js
# (заполняется install.sh: __DOMAIN__ и __PORT__)

# Глобальные опции: разрешение on-demand TLS через endpoint приложения
{
    on_demand_tls {
        ask http://localhost:__PORT__/api/caddy/ask
    }
}

# Основной домен — приложение (редактор, дашборд)
__DOMAIN__ {
    reverse_proxy localhost:__PORT__
    encode gzip
}

# Бесплатные поддомены <имя>.__DOMAIN__ (нужна wildcard A-запись *.DOMAIN → IP)
*.__DOMAIN__ {
    tls {
        on_demand
    }
    reverse_proxy localhost:__PORT__
    encode gzip
}

# Собственные домены пользователей (любые другие hostnames)
https:// {
    tls {
        on_demand
    }
    reverse_proxy localhost:__PORT__
    encode gzip
}
